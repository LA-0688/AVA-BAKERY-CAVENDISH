{
  "name": "ava-bakery-cavendish",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "npm run dev --workspace=@bakery/web",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "npm run typecheck --workspace=@bakery/web"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.12.1"
}
